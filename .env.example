# Server-side only. Never prefix anything with NEXT_PUBLIC_ (that ships it to browsers).

# allinc-api base URL. Local dev: the API container on the host. In compose: http://api:8080 (set there).
ALLINC_API_URL=http://localhost:8080

# live | record | replay. replay answers from dev/fixtures and spends no supplier quota.
ALLINC_API_MODE=live

# Key for sealed links and image addresses. Required in production. Generate: openssl rand -base64 48
WEB_SEAL_KEY=

# Shared secret for the API's /checkout routes: the same value as the API's Checkout__WebKey.
# Required in production. Generate: /usr/bin/openssl rand -base64 32
ALLINC_WEB_KEY=

# Test bookings from the checkout ("Boka testresa", no payment): 1 to turn on. The API books only on
# the suppliers' test systems while there is no payment provider. Leave off in production.
ALLINC_TEST_BOOKINGS=0

# replay mode only: what "Till betalning" answers (ok | changed | soldout-flight | soldout-room |
# soldout-hotel | soldout-transfer | cannotconfirm | expired).
ALLINC_REPLAY_CHECKOUT=ok

# Hotel texts language (each language is its own supplier content call).
CONTENT_LANGUAGE=en
